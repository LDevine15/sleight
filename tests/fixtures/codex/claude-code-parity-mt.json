{
 "toClient": [
  {
   "jsonrpc": "2.0",
   "id": "init",
   "result": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "serverInfo": {
     "name": "engine"
    }
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 1,
   "result": {
    "tools": [
     {
      "name": "js",
      "description": "Run.",
      "inputSchema": {
       "type": "object"
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "turn_ended",
      "description": "Internal to sleight: its hooks call this when a Claude turn ends. Never call it yourself.",
      "inputSchema": {
       "type": "object"
      }
     },
     {
      "name": "browser_open",
      "description": "Open an owned background tab and return its first untrusted snapshot. Keep the tab handle.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "url": {
         "type": "string",
         "maxLength": 65536
        },
        "browser": {
         "type": "string",
         "enum": [
          "bfixture"
         ]
        }
       },
       "required": [
        "url"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_read",
      "description": "Read protected, untrusted page state. Use ref for a subtree or continuation, find for matching lines (a|b matches either). Refs outside the viewport carry [offscreen] or [partly offscreen]. Reads never grant permission.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        },
        "ref": {
         "type": "string",
         "maxLength": 65536
        },
        "find": {
         "type": "string",
         "maxLength": 65536
        },
        "max_chars": {
         "type": "integer",
         "minimum": 1000,
         "maximum": 40000
        },
        "text": {
         "type": "boolean"
        }
       },
       "required": [
        "tab"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_act",
      "description": "Run 1 to 12 steps on observed refs, returning outcome lines and a diff. A step that navigates, opens a tab, raises a dialog, loads or closes the page, or reaches the settle cap ends the batch (later steps read \"not reached\"), so put one such step last. Never blindly resend an uncertain submit. click accepts modifier:cmd/ctrl. viewport with width and height resizes and reports the old size; with neither it restores that size. scroll with until:text finds a row in a long list. navigate with a link ref follows it.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        },
        "steps": {
         "type": "array",
         "minItems": 1,
         "maxItems": 12,
         "items": {
          "type": "object",
          "properties": {
           "do": {
            "type": "string",
            "enum": [
             "click",
             "type",
             "press",
             "select",
             "check",
             "uncheck",
             "hover",
             "scroll",
             "drag",
             "upload",
             "dialog",
             "wait",
             "back",
             "forward",
             "reload",
             "viewport",
             "navigate"
            ]
           },
           "ref": {
            "type": "string",
            "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|s[0-9]+)$"
           },
           "text": {
            "type": "string",
            "maxLength": 65536
           },
           "key": {
            "type": "string",
            "maxLength": 65536
           },
           "modifier": {
            "type": "string",
            "enum": [
             "cmd",
             "ctrl"
            ]
           },
           "values": {
            "type": [
             "string",
             "array"
            ],
            "items": {
             "type": "string",
             "maxLength": 65536
            },
            "maxItems": 100
           },
           "to": {
            "type": "string",
            "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|s[0-9]+)$"
           },
           "until": {
            "type": "string",
            "maxLength": 65536
           },
           "ms": {
            "type": "number",
            "minimum": 0
           },
           "dx": {
            "type": "number"
           },
           "dy": {
            "type": "number"
           },
           "accept": {
            "type": "boolean"
           },
           "paths": {
            "type": "array",
            "maxItems": 100,
            "items": {
             "type": "string",
             "maxLength": 65536
            }
           },
           "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
           },
           "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
           }
          },
          "required": [
           "do"
          ],
          "additionalProperties": false
         }
        },
        "observe": {
         "type": "string",
         "enum": [
          "diff",
          "full",
          "none"
         ]
        }
       },
       "required": [
        "tab",
        "steps"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_fill",
      "description": "Fill up to 60 observed fields in one call: text or a number for a textbox; true or false for a checkbox, switch or the radio option to choose; a number for a slider; the option text for a select or combobox, even in a long or virtual list; all row names in the wanted order for a drag-reorderable list. For a multi-select, an array sets exactly those option texts; [] clears all. submit is an observed ref, only when the user asked for that submit. Returns each field's status and the page diff.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        },
        "fields": {
         "type": "array",
         "minItems": 1,
         "maxItems": 60,
         "items": {
          "type": "object",
          "properties": {
           "ref": {
            "type": "string",
            "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|s[0-9]+)$"
           },
           "value": {
            "type": [
             "string",
             "boolean",
             "number",
             "array"
            ],
            "items": {
             "type": "string",
             "maxLength": 65536
            },
            "maxItems": 100,
            "maxLength": 65536
           }
          },
          "required": [
           "ref",
           "value"
          ],
          "additionalProperties": false
         }
        },
        "submit": {
         "type": "string",
         "pattern": "^(?:(?:f[0-9]+)?e[0-9]+|s[0-9]+)$"
        }
       },
       "required": [
        "tab",
        "fields"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     },
     {
      "name": "browser_tabs",
      "description": "List owned tabs, close one, keep one open for the user to look at after the turn, or hand one off when the user must act in it (sign-in, payment the user did not ask for, a code). Owned tabs only.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "do": {
         "type": "string",
         "enum": [
          "list",
          "close",
          "keep",
          "handoff"
         ]
        },
        "tab": {
         "type": "string",
         "pattern": "^t[A-Za-z0-9_-]{1,64}$"
        }
       },
       "required": [
        "do"
       ],
       "additionalProperties": false
      },
      "_meta": {
       "anthropic/alwaysLoad": true
      }
     }
    ]
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 2,
   "result": {
    "isError": false,
    "content": [
     {
      "type": "text",
      "text": "{\"sleightTurbo\":{\"version\":1,\"session\":\"<session>\",\"nonce\":\"<nonce>\"}}"
     }
    ]
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 3,
   "result": {
    "isError": false,
    "content": []
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 4,
   "result": {
    "isError": false,
    "content": [
     {
      "type": "text",
      "text": "plain result"
     }
    ]
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 5,
   "result": {
    "content": [
     {
      "type": "text",
      "text": "2"
     }
    ]
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 6,
   "result": {
    "content": [
     {
      "type": "text",
      "text": "{\"directBrowser\":{\"revoked\":true,\"cleanup\":[]}}"
     }
    ],
    "isError": false,
    "_meta": {
     "sleight/directBrowser": {
      "revoked": true,
      "cleanup": []
     }
    }
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 7,
   "error": {
    "code": -32602,
    "message": "Unknown tool"
   }
  }
 ],
 "toServer": [
  {
   "jsonrpc": "2.0",
   "id": "init",
   "method": "initialize",
   "params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {
     "elicitation": {
      "form": {}
     }
    },
    "clientInfo": {
     "name": "claude-code",
     "title": "Claude Code",
     "version": "2.1.289"
    }
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 1,
   "method": "tools/list"
  },
  {
   "jsonrpc": "2.0",
   "id": 5,
   "method": "tools/call",
   "params": {
    "name": "js",
    "arguments": {
     "code": "<engine code>"
    },
    "_meta": {
     "x-codex-turn-metadata": "{\"session_id\":\"<uuid>\",\"turn_id\":\"<uuid>\"}"
    }
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 6,
   "method": "tools/call",
   "params": {
    "name": "turn_ended",
    "arguments": {
     "hook_event_name": "Stop",
     "session_id": "<uuid>",
     "turn_id": "<uuid>"
    }
   }
  },
  {
   "jsonrpc": "2.0",
   "id": 7,
   "method": "tools/call",
   "params": {
    "name": "turn_started",
    "arguments": {
     "hook_event_name": "UserPromptSubmit",
     "session_id": "<uuid>",
     "turn_id": "turn-1",
     "prompt": "Read the page"
    },
    "_meta": {
     "threadId": "<uuid>",
     "x-codex-turn-metadata": "{\"session_id\":\"<uuid>\",\"turn_id\":\"<uuid>\"}"
    }
   }
  }
 ],
 "worker": [
  [
   "begin",
   "read",
   "Claude Code 2.1.289"
  ],
  [
   "call",
   "browser_read"
  ],
  [
   "end"
  ]
 ]
}
